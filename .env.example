# Airtable personal access token (create at https://airtable.com/create/tokens)
# Needs data.records:read / data.records:write scopes for your base.
VITE_AIRTABLE_TOKEN=

# The base ID for your moving-inventory base (starts with "app...")
VITE_AIRTABLE_BASE_ID=

# Name of the table that holds boxes (defaults used in code if unset)
VITE_AIRTABLE_BOXES_TABLE=Boxes
