# Supabase project settings (Project Settings → API in the Supabase dashboard).
# The anon key is safe-ish to ship to the browser — Row Level Security is what
# actually enforces per-household access, not secrecy of this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Anthropic API key for AI item splitting (api/split-items.js). Server-only —
# no VITE_ prefix, so it never reaches the browser. On Vercel, add it under
# Project Settings → Environment Variables.
ANTHROPIC_API_KEY=
