# Server-only — read by the API routes in /api, never by the browser.
# Deliberately NOT prefixed with VITE_: Vite only exposes VITE_-prefixed
# vars to client code, so these stay server-side both locally (via the dev
# middleware in vite.config.js) and in production (as Vercel project env vars).

# Airtable personal access token (create at https://airtable.com/create/tokens)
# Needs data.records:read / data.records:write scopes for your base.
AIRTABLE_TOKEN=

# The base ID for your moving-inventory base (starts with "app...")
AIRTABLE_BASE_ID=
